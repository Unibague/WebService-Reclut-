# Copiar este archivo a ".env" y completar los valores reales.
# El archivo ".env" NUNCA debe subirse al repositorio (ver .gitignore).

# URL de la API de estudiantes de Unibagué (normalmente no cambia).
UNIBAGUE_API_URL=http://integra.unibague.edu.co/students/all

# Token de acceso a la API de Unibagué (obligatorio).
UNIBAGUE_API_TOKEN=

# Tiempo de vida de la caché local, en segundos (por defecto 3600 = 1 hora).
CACHE_TTL=3600

# Dominios permitidos para CORS, separados por coma.
# Usar "*" para no restringir (no recomendado en producción).
# Ejemplo: REQLUT_ALLOWED_ORIGINS=https://app.reqlut.com,https://reqlut.com
REQLUT_ALLOWED_ORIGINS=*

# API key que Reqlut debe enviar en el header "X-Api-Key" o en
# el parámetro "?api_key=". Dejar vacío para no exigir autenticación.
WEBSERVICE_API_KEY=

# Clave para invalidar manualmente la caché vía clear_cache.php?key=...
# Dejar vacío para deshabilitar ese endpoint.
CACHE_ADMIN_KEY=
